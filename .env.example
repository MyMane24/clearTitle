# ============================================================
#  Property OCR — Environment Variables
#  Copy this file to .env and fill in your API keys.
#  The .env file is git-ignored and never committed.
# ============================================================

# ── External API Keys ───────────────────────────────────────
SARVAM_API_KEY=your_sarvam_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# Single-call OCR classification + structured extraction (OpenAI-compatible)
DOCUMENT_PROCESSOR_MODEL=gpt-6-luna
DOCUMENT_CLASSIFICATION_TOKEN_BUDGET=3000
# Optional for Azure/OpenAI-compatible endpoints
OPENAI_API_BASE=
OPENAI_API_VERSION=2024-02-15-preview

# Verification agent defaults to OpenAI; Gemini is an optional provider.
CLEARTITLE_AGENT_PROVIDER=openai
CLEARTITLE_AGENT_MODEL=GPT-6 Luna
# Set CLEARTITLE_AGENT_PROVIDER=gemini, provide GEMINI_API_KEY, and configure a supported Gemini model to use Gemini instead.
GEMINI_API_KEY=

# ── Security keys ────────────────────────────────────────────
JWT_SECRET_KEY=change-this-to-a-long-random-string-in-production

# ── Google OAuth (optional — enables "Continue with Google") ──
# Create OAuth 2.0 credentials at https://console.cloud.google.com/apis/credentials
# Authorized redirect URI must exactly match GOOGLE_REDIRECT_URI below.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback
GOOGLE_FRONTEND_REDIRECT_URI=http://localhost:8000/login

# ── MySQL ────────────────────────────────────────────────────
# These defaults work out-of-the-box with Docker Compose.
# Only change if you are connecting to an external MySQL server.
MYSQL_ROOT_PASSWORD=rootpass_change_me
MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_USER=property_user
MYSQL_PASSWORD=property_pass_123
MYSQL_DATABASE=property_ocr_v2

# ── Redis ────────────────────────────────────────────────────
# Works out-of-the-box with Docker Compose. Do not change.
REDIS_URL=redis://redis:6379/0
