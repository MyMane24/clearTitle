# ============================================================
#  Property OCR — Environment Variables
#  Copy this file to .env and fill in your API keys.
#  The .env file is git-ignored and never committed.
# ============================================================

# ── External API Keys (REQUIRED — get from each provider) ──
SARVAM_API_KEY=your_sarvam_api_key_here
GROQ_API_KEY=your_groq_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here

# ── Model settings ──────────────────────────────────────────
GEMINI_MODEL=gemini-2.5-flash
GEMINI_MAX_CONTEXT_CHARS=800000
PRIMARY_STRUCTURER=groq

# ── Security keys ────────────────────────────────────────────
# Generate a Fernet key with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=your_fernet_key_here
JWT_SECRET_KEY=change-this-to-a-long-random-string-in-production

# ── MySQL ────────────────────────────────────────────────────
# These defaults work out-of-the-box with Docker Compose.
# Only change if you are connecting to an external MySQL server.
MYSQL_ROOT_PASSWORD=rootpass_change_me
MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_USER=property_user
MYSQL_PASSWORD=property_pass_123
MYSQL_DATABASE=property_ocr_v2

# ── Redis ────────────────────────────────────────────────────
# Works out-of-the-box with Docker Compose. Do not change.
REDIS_URL=redis://redis:6379/0
